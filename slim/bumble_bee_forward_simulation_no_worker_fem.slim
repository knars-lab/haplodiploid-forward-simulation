survival()
{
	// non-overlapping generations, avoid fitness-based mortality
	return (individual.age == 0);
}

1: late() {
	// Retrieve current generation information 
	inds = sim.subpopulations.individuals;	
	Nf = sim.getValue("Nf");
   Nm = sim.getValue("Nm");
   new_queens = sim.getValue("new_queens");
	expected_heterozygosity_colony_founding_queens = sim.getValue("exp_het_queens");
   colony_sizes = sim.getValue("colony_sizes"); 
   virgin_queens = sum(inds.tag == 1);
   new_males = sum(inds.sex == "M");
   fixedCount = sim.substitutions.size();
   
	if (sim.generation == 1)
		N = size(inds);
	else
		N = sum(colony_sizes);
   
	if (sim.generation >= simulation_length)
		sim.simulationFinished();	
	
	if (sim.generation > 1 & 
		(Nf == 0 | Nm == 0 | new_males == 0 | virgin_queens == 0)) {
		catn("extinction at generation  " + sim.generation);
		sim.simulationFinished();
		return;
		}
	
	
   // Calculate Ne
   if (Nf == 0 & Nm == 0)
		Ne = 0;
   else
		Ne = Nf + Nm;
	
	catn(sim.generation + " " + fixedCount + " " + expected_heterozygosity_colony_founding_queens +  " " + Nf + " " + Nm + " " + Ne + " " + N + " [" + paste(colony_sizes, sep=",") + "]" + " [" + paste(new_queens, sep=",") + "]");		
}

